#!/usr/bin/env perl

use strict;
use warnings;

use FindBin qw($Bin);
use lib $Bin, "$Bin/lib";

use AsteriskAlexa::Multipart qw(extract_mpeg_audio);
use File::Spec;
use File::Temp qw(tempdir tempfile);
use JSON::PP qw(decode_json encode_json);

$| = 1;

my $debug = $ENV{ALEXA_DEBUG} // 0;
my $config_file = $ENV{ALEXA_CONFIG} || "/etc/asterisk/alexa.conf";
my $token_helper
    = $ENV{ALEXA_TOKEN_HELPER}
    || "/usr/local/libexec/asterisk-alexa/token.pl";
my $sox = "/usr/bin/sox";
my $curl = "/usr/bin/curl";
my $format = "sln";
my $default_timeout = 2;
my $absolute_timeout = 30_000;
my $interrupt_key = "#";
my $beep = "BEEP";
my $thank_you = "/usr/share/asterisk/sounds/en/auth-thankyou";
our $LAST_RESULT = -1;

my %agi;
($agi{arg_1}, $agi{arg_2}, $agi{arg_3}, $agi{arg_4}) = @ARGV;
while (my $line = <STDIN>) {
    chomp $line;
    last if !length $line;
    $agi{$1} = $2 if $line =~ /^agi_(\w+):\s+(.*)$/;
}

my $name = "alexa.agi";
my $work_dir = tempdir("asterisk-alexa-XXXXXX", TMPDIR => 1, CLEANUP => 1);
my $recording = File::Spec->catfile($work_dir, "request");
my $wav_file = "$recording.wav";
my $request_file = File::Spec->catfile($work_dir, "request.dat");
my $response_file = File::Spec->catfile($work_dir, "response.dat");
my $response_headers = File::Spec->catfile($work_dir, "response.headers");
my $response_audio = File::Spec->catfile($work_dir, "response.mp3");

my $language = defined $agi{arg_1} ? $agi{arg_1} : "en-us";
$language =~ /^[a-z]{2}(?:-[A-Za-z]{2,6})?$/
    or fatal("Invalid locale: $language");

my $silence = "s=$default_timeout";
if (defined $agi{arg_2} && length $agi{arg_2}) {
    if ($agi{arg_2} eq "-1") {
        $silence = "";
    } elsif ($agi{arg_2} =~ /^\d+$/) {
        $silence = "s=$agi{arg_2}";
    } else {
        fatal("Invalid silence timeout: $agi{arg_2}");
    }
}

if (defined $agi{arg_3} && length $agi{arg_3}) {
    if ($agi{arg_3} eq "any") {
        $interrupt_key = "0123456789#*";
    } elsif ($agi{arg_3} =~ /^[0-9*#]+$/) {
        $interrupt_key = $agi{arg_3};
    } else {
        fatal("Invalid interrupt key: $agi{arg_3}");
    }
}

if (defined $agi{arg_4} && length $agi{arg_4}) {
    $agi{arg_4} eq "NOBEEP"
        or fatal("Fourth argument must be NOBEEP when provided.");
    $beep = "";
}

my $settings = read_config($config_file);
my $avs_url
    = $settings->{avs_url}
    || "https://access-alexa-na.amazon.com/v1/avs/speechrecognizer/recognize";
my $http_timeout = $settings->{http_timeout_seconds} || 30;
$avs_url =~ m{\Ahttps://}i
    or fatal("avs_url must use HTTPS.");
$http_timeout =~ /^\d+$/
    or fatal("http_timeout_seconds must be a non-negative integer.");

agi_log("Starting request for locale $language.");
agi_command("CHANNEL STATUS");
if ($LAST_RESULT == 4) {
    agi_command("ANSWER");
    $LAST_RESULT == 0 or fatal("Failed to answer channel.");
}

my $token = get_access_token();

my @record_parts = (
    "RECORD FILE",
    $recording,
    $format,
    quote_agi($interrupt_key),
    quote_agi($absolute_timeout),
);
push @record_parts, $beep if length $beep;
push @record_parts, quote_agi($silence);
agi_command(join " ", @record_parts);
$LAST_RESULT >= 0 or fatal("Failed to record audio.");

playback($thank_you, $interrupt_key);

run_command(
    $sox,
    "$recording.$format",
    "-e", "signed-integer",
    "-b", "16",
    "-r", "16000",
    $wav_file,
);

build_legacy_avs_request(
    $settings->{metadata_file} || "/etc/asterisk/avs_audio.json",
    $wav_file,
    $request_file,
    $language,
);

my ($header_fh, $header_file)
    = tempfile("curl-headers-XXXXXX", DIR => $work_dir);
chmod 0600, $header_file
    or fatal("Cannot protect temporary authorization header: $!");
print {$header_fh} "Authorization: Bearer $token\n"
    or fatal("Cannot write temporary authorization header: $!");
close $header_fh
    or fatal("Cannot close temporary authorization header: $!");

run_command(
    $curl,
    "--silent",
    "--show-error",
    "--fail-with-body",
    "--max-time", $http_timeout,
    "--output", $response_file,
    "--dump-header", $response_headers,
    "--header", "\@$header_file",
    "--header", "Content-Type: multipart/form-data; boundary=A1234567890",
    "--data-binary", "\@$request_file",
    $avs_url,
);

my $audio = extract_mpeg_part($response_headers, $response_file);
open(my $audio_fh, ">:raw", $response_audio)
    or fatal("Cannot write response audio: $!");
print {$audio_fh} $audio
    or fatal("Cannot write response audio: $!");
close $audio_fh
    or fatal("Cannot close response audio: $!");

run_command(
    $sox,
    $response_audio,
    "-t", "raw",
    "-r", "8000",
    "-e", "signed-integer",
    "-b", "16",
    "-c", "1",
    "$recording.sln",
);

playback($recording, $interrupt_key);
exit 0;

sub agi_command {
    my ($command) = @_;
    print "$command\n";
    my $input = <STDIN>;
    defined $input or fatal("Asterisk closed the AGI connection.");
    chomp $input;

    if ($input =~ /^200 result=(-?\d+)\s?(.*)$/) {
        $LAST_RESULT = $1;
        warn "$name: $command -> $input\n" if $debug;
        return ($1, $2);
    }

    if ($input =~ /^520-Invalid/) {
        while (my $extra = <STDIN>) {
            last if $extra =~ /^520 End/;
        }
    }
    fatal("Unexpected AGI response to '$command': $input");
}

sub playback {
    my ($file, $keys) = @_;
    agi_command("STREAM FILE $file " . quote_agi($keys));
    $LAST_RESULT >= 0 or fatal("Failed to play $file.");
}

sub agi_log {
    my ($message) = @_;
    warn "$name: $message\n";
    agi_command("VERBOSE " . quote_agi("$name: $message") . " 2") if $debug;
}

sub fatal {
    my ($message) = @_;
    die "$name: $message\n";
}

sub quote_agi {
    my ($value) = @_;
    $value //= "";
    $value =~ s/(["\\])/\\$1/g;
    return qq{"$value"};
}

sub read_config {
    my ($path) = @_;
    open(my $fh, "<", $path)
        or fatal("Cannot read configuration $path: $!");
    my %settings;
    my $line_number = 0;
    while (my $line = <$fh>) {
        $line_number++;
        chomp $line;
        $line =~ s/\r$//;
        next if $line =~ /^\s*(?:#|$)/;
        $line =~ /^([A-Za-z][A-Za-z0-9_]*)=(.*)$/
            or fatal("Invalid configuration at $path line $line_number.");
        my ($key, $value) = ($1, $2);
        $value =~ s/^\s+|\s+$//g;
        $settings{$key} = $value;
    }
    close $fh or fatal("Cannot close configuration $path: $!");
    return \%settings;
}

sub get_access_token {
    open(my $fh, "-|", $token_helper, "--config", $config_file, "--print-token")
        or fatal("Cannot start token helper: $!");
    local $/;
    my $value = <$fh>;
    close $fh
        or fatal("Token helper failed.");
    $value //= "";
    $value =~ s/\s+\z//;
    length $value
        or fatal("Token helper returned an empty token.");
    return $value;
}

sub run_command {
    my @command = @_;
    warn "$name: running $command[0]\n" if $debug;
    system @command;
    if ($? == -1) {
        fatal("Cannot execute $command[0]: $!");
    }
    if ($? & 127) {
        fatal(sprintf("%s terminated by signal %d.", $command[0], $? & 127));
    }
    my $exit_code = $? >> 8;
    $exit_code == 0
        or fatal("$command[0] exited with status $exit_code.");
}

sub build_legacy_avs_request {
    my ($metadata_path, $audio_path, $output_path, $locale) = @_;

    open(my $metadata_fh, "<", $metadata_path)
        or fatal("Cannot read AVS metadata $metadata_path: $!");
    local $/;
    my $template = <$metadata_fh>;
    close $metadata_fh
        or fatal("Cannot close AVS metadata $metadata_path: $!");

    my $metadata = eval { decode_json($template) };
    ref $metadata eq "HASH"
        or fatal("AVS metadata JSON is invalid.");
    $metadata->{messageBody}{locale} = $locale;

    open(my $audio_fh, "<:raw", $audio_path)
        or fatal("Cannot read recorded audio $audio_path: $!");
    my $audio = <$audio_fh>;
    close $audio_fh
        or fatal("Cannot close recorded audio $audio_path: $!");

    my $boundary = "A1234567890";
    my $request
        = "--$boundary\r\n"
        . "Content-Disposition: form-data; name=\"file\"; filename=\"request\"\r\n"
        . "Content-Type: application/json; charset=UTF-8\r\n\r\n"
        . encode_json($metadata)
        . "\r\n--$boundary\r\n"
        . "Content-Disposition: form-data; name=\"file\"; filename=\"audio\"\r\n"
        . "Content-Type: audio/L16; rate=16000; channels=1\r\n\r\n"
        . $audio
        . "\r\n--$boundary--\r\n";

    open(my $output_fh, ">:raw", $output_path)
        or fatal("Cannot write AVS request $output_path: $!");
    print {$output_fh} $request
        or fatal("Cannot write AVS request $output_path: $!");
    close $output_fh
        or fatal("Cannot close AVS request $output_path: $!");
}

sub extract_mpeg_part {
    my ($headers_path, $body_path) = @_;

    open(my $headers_fh, "<", $headers_path)
        or fatal("Cannot read HTTP response headers: $!");
    local $/;
    my $headers = <$headers_fh>;
    close $headers_fh
        or fatal("Cannot close HTTP response headers: $!");

    my @content_types = $headers =~ /^Content-Type:\s*([^\r\n]+)/img;
    @content_types
        or fatal("AVS response did not include Content-Type.");
    my $content_type = $content_types[-1];
    $content_type =~ /^multipart\//i
        or fatal("AVS response was not multipart: $content_type");

    open(my $body_fh, "<:raw", $body_path)
        or fatal("Cannot read AVS response body: $!");
    my $body = <$body_fh>;
    close $body_fh
        or fatal("Cannot close AVS response body: $!");

    my $audio = eval { extract_mpeg_audio($content_type, $body) };
    defined $audio
        or fatal("Cannot parse AVS response: " . ($@ || "unknown error"));
    return $audio;
}
